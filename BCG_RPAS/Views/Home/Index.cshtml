@{
    ViewData["Title"] = "หน้าหลัก";
}

<div class="py-4">
    @if (User.Identity?.IsAuthenticated == true)
    {
        var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity.Name;
        var roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "ผู้ใช้งาน";
        var roleCode = User.FindFirst("RoleCode")?.Value ?? "";
        var canManageMaster = !string.Equals(roleCode, "REQUESTER", StringComparison.OrdinalIgnoreCase);
        var isAdmin = string.Equals(roleCode, "ADMINISTRATOR", StringComparison.OrdinalIgnoreCase);

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="card-body p-4 p-md-5" style="background: linear-gradient(135deg, #0F5132 0%, #198754 100%); color: white;">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        
                        <h1 class="display-6 fw-bold mb-1">ยินดีต้อนรับ, @displayName</h1>
                        <span class="badge bg-white text-success px-3 py-2 rounded-pill fw-bold mb-2">
                            @roleName
                        </span>
                        <p class="mb-0 opacity-75">ระบบบริหารและอนุมัติการจ่ายค่าเช่า BCG RPAS</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 position-relative">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2 text-success">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            <h5 class="card-title mb-0 fw-bold">คำขออนุมัติค่าเช่า</h5>
                        </div>
                        <p class="card-text text-muted small mb-3">ระบบจัดการรายการขออนุมัติจ่ายค่าเช่าและสัญญา</p>
                        <a asp-controller="RentalRequests" asp-action="Index" class="btn btn-outline-success btn-sm stretched-link">
                            เปิดดูรายการคำขอ &rarr;
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 p-3 position-relative">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2 text-primary">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                            <h5 class="card-title mb-0 fw-bold">กล่องงานรออนุมัติ</h5>
                        </div>
                        <p class="card-text text-muted small mb-3">พิจารณาอนุมัติ ส่งคืนแก้ไข หรือปฏิเสธคำขอค่าเช่าที่ได้รับมอบหมาย</p>
                        <a asp-controller="Approvals" asp-action="Index" class="btn btn-outline-primary btn-sm stretched-link">
                            เปิดกล่องงานรออนุมัติ &rarr;
                        </a>
                    </div>
                </div>
            </div>
            @if (canManageMaster)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100 p-3 position-relative">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2 text-warning">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                <h5 class="card-title mb-0 fw-bold">จัดการข้อมูลหลัก</h5>
                            </div>
                            <p class="card-text text-muted small mb-3">สัญญาเช่า, ผู้ให้เช่า, แผนก/ฝ่าย และประเภทค่าเช่า</p>
                            <a asp-controller="MasterData" asp-action="Index" class="btn btn-outline-warning text-dark btn-sm stretched-link fw-semibold">
                                จัดการข้อมูลหลัก &rarr;
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100 p-3 position-relative">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2 text-info-emphasis">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                                <h5 class="card-title mb-0 fw-bold">ติดตามการส่ง ERP</h5>
                            </div>
                            <p class="card-text text-muted small mb-3">ตรวจสอบคิวการซิงค์ข้อมูลไป ERP ประวัติการส่งซ้ำ และเลขอ้างอิงการจ่ายเงิน</p>
                            <a asp-controller="ErpMonitoring" asp-action="Index" class="btn btn-outline-info text-dark btn-sm stretched-link fw-semibold">
                                เปิดหน้าติดตาม ERP &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
            @if (isAdmin)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100 p-3 position-relative">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2 text-danger">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                <h5 class="card-title mb-0 fw-bold">จัดการสายอนุมัติ</h5>
                            </div>
                            <p class="card-text text-muted small mb-3">ผูกสายการอนุมัติขั้นที่ 1 (ผู้จัดการ) และขั้นที่ 2 (ผู้บริหาร) ให้กับผู้ขออนุมัติ</p>
                            <a asp-controller="ApprovalAssignments" asp-action="Index" class="btn btn-outline-danger btn-sm stretched-link fw-semibold">
                                ตั้งค่าสายอนุมัติ &rarr;
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100 p-3 position-relative">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2 text-dark">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                                <h5 class="card-title mb-0 fw-bold">จัดการผู้ใช้งาน</h5>
                            </div>
                            <p class="card-text text-muted small mb-3">สร้างบัญชีผู้ใช้งานใหม่ กำหนดบทบาท แก้ไขข้อมูล หรือเปลี่ยนรหัสผ่าน</p>
                            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-dark btn-sm stretched-link fw-semibold">
                                จัดการผู้ใช้งาน &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h1 class="display-5 fw-bold text-dark mb-3">BCG RPAS</h1>
            <p class="lead text-muted mx-auto" style="max-width: 600px;">
                ระบบบริหารและอนุมัติการจ่ายค่าเช่าแบบบูรณาการ
            </p>
            <div class="mt-4">
                <a class="btn btn-success btn-lg px-4 py-2 shadow-sm rounded-pill fw-bold" asp-controller="Account" asp-action="Login">
                    เข้าสู่ระบบ
                </a>
            </div>
        </div>
    }
</div>
