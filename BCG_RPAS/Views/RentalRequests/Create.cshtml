@{
    ViewData["Title"] = "สร้างคำขอค่าเช่าใหม่";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Title -->
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            กลับไปยังรายการคำขอ
        </a>
        <h2 class="fw-bold mb-1" style="color: #0F5132;">สร้างคำขอค่าเช่าใหม่</h2>
        <p class="text-muted">กรอกรายละเอียดสัญญา ข้อมูลการเงิน และอัปโหลดเอกสารอ้างอิงเพื่อขออนุมัติ</p>
    </div>

    <!-- Alert Notification Container -->
    <div id="formAlert" class="alert d-none rounded-3 shadow-sm mb-4" role="alert"></div>

    <form id="rentalRequestForm">
        <!-- Card 1: สัญญาและข้อมูลผู้ให้เช่า -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-3">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success rounded-circle p-2">1</span>
                    ข้อมูลสัญญาและแผนก/ฝ่าย
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="contractSelect">
                            เลขที่สัญญา <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="contractSelect" required>
                            <option value="">-- กำลังโหลดรายการสัญญา... --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="costCenterSelect">
                            แผนก / ฝ่าย <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="costCenterSelect" required>
                            <option value="">-- กำลังโหลดข้อมูลแผนก/ฝ่าย... --</option>
                        </select>
                    </div>

                    <!-- Auto-populated from contract -->
                    <div class="col-md-6">
                        <label class="form-label text-muted small">ผู้ให้เช่า <span class="badge bg-light text-secondary">ดึงจากสัญญา</span></label>
                        <input type="text" class="form-control bg-light" id="vendorNameInput" placeholder="จะแสดงอัตโนมัติเมื่อเลือกสัญญา" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-muted small">ประเภทค่าเช่า <span class="badge bg-light text-secondary">ดึงจากสัญญา</span></label>
                        <input type="text" class="form-control bg-light" id="rentalTypeNameInput" placeholder="จะแสดงอัตโนมัติเมื่อเลือกสัญญา" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: ข้อมูลงวดและจำนวนเงิน -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-3">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success rounded-circle p-2">2</span>
                    งวดเวลาและจำนวนเงิน
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="periodStartDate">
                            วันเริ่มต้นงวด <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control bg-white" id="periodStartDate" placeholder="dd/MM/yyyy" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="periodEndDate">
                            วันสิ้นสุดงวด <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control bg-white" id="periodEndDate" placeholder="dd/MM/yyyy" required />
                    </div>

                    <div class="col-12 d-none" id="periodDurationBox">
                        <div class="px-3 py-2 rounded-3 bg-success-subtle text-success small fw-semibold d-flex align-items-center justify-content-between">
                            <span>ระยะเวลางวดเช่า: <strong id="periodDurationText" class="fs-6 ms-1"></strong></span>
                            <span id="periodTotalDaysText" class="badge bg-white text-success border"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="amountInput">
                            ยอดเงินก่อน VAT (บาท) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="0.01" class="form-control" id="amountInput" placeholder="0.00" required />
                            <span class="input-group-text bg-light">บาท</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="vatRateInput">
                            อัตรา VAT (%) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="0" max="100" class="form-control" id="vatRateInput" value="7.00" required />
                            <span class="input-group-text bg-light">%</span>
                        </div>
                    </div>

                    <!-- Calculated summary box -->
                    <div class="col-12 mt-4">
                        <div class="p-3 rounded-3" style="background-color: #F8FAFC; border: 1.5px dashed #CBD5E1;">
                            <div class="row g-2 text-center text-md-start align-items-center">
                                <div class="col-md-4">
                                    <small class="text-muted d-block">ภาษีมูลค่าเพิ่ม (VAT)</small>
                                    <span class="fw-bold text-dark fs-5" id="vatAmountDisplay">0.00 ฿</span>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block">ยอดรวมสุทธิ</small>
                                    <span class="fw-bold text-success fs-4" id="totalAmountDisplay">0.00 ฿</span>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <div id="approvalPolicyBadge" class="badge bg-secondary-subtle text-secondary p-2 rounded-3 text-wrap" style="font-size: 0.82rem; line-height: 1.4;">
                                        กรุณาระบุยอดเงินเพื่อประเมินสายอนุมัติ
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: เอกสารแนบและหมายเหตุ -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-3">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success rounded-circle p-2">3</span>
                    เอกสารแนบและหมายเหตุ
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-4">
                    <label class="form-label fw-semibold" for="pdfFileInput">
                        อัปโหลดไฟล์เอกสารแนบ (เฉพาะไฟล์ PDF) <span class="text-danger">*</span>
                    </label>
                    <p class="text-muted small mb-2">
                        เลือกไฟล์เอกสาร เช่น ใบแจ้งหนี้ หรือสำเนาสัญญา (รองรับเฉพาะไฟล์ <code>.pdf</code> ขนาดไม่เกิน 15 MB ต่อไฟล์ ระบบจะตั้งชื่อไฟล์เป็น <code>YYYYMMDD_HHMMSSfff.pdf</code> อัตโนมัติเมื่อบันทึก)
                    </p>

                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <input type="file" id="pdfFileInput" accept=".pdf,application/pdf" multiple class="form-control" style="max-width: 460px;" />
                    </div>

                    <!-- File list container -->
                    <div id="attachmentsContainer" class="d-flex flex-wrap gap-2 pt-1">
                        <span class="text-muted small" id="emptyAttachmentNote">ยังไม่ได้เลือกไฟล์เอกสารแนบ</span>
                    </div>
                </div>

                <div>
                    <label class="form-label fw-semibold" for="notesInput">หมายเหตุเพิ่มเติม</label>
                    <textarea class="form-control" id="notesInput" rows="3" placeholder="ระบุรายละเอียดเพิ่มเติม หรือวัตถุประสงค์ในการขออนุมัติจ่ายค่าเช่า..."></textarea>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 mb-5">
            <a asp-action="Index" class="btn btn-light px-4 py-2 text-muted fw-semibold">
                ยกเลิกและย้อนกลับ
            </a>
            <div class="d-flex gap-2">
                <button type="button" id="btnSaveDraft" class="btn btn-outline-success px-4 py-2 fw-semibold">
                    <span id="btnSaveDraftText">บันทึกร่าง</span>
                </button>
                <button type="button" id="btnSubmitRequest" class="btn btn-success px-4 py-2 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #16A34A 0%, #0F5132 100%); border: none;">
                    <span id="btnSubmitText">ส่งขออนุมัติ</span>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let contractsList = [];
            let pendingFiles = []; // Array of File objects selected by user

            // 1. Load Master Data
            $.ajax({
                url: '@Url.Action("GetMasters", "RentalRequests")',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res) {
                        contractsList = res.contracts || [];
                        let contractOptions = '<option value="">-- ค้นหาหรือเลือกสัญญาเช่า --</option>';
                        contractsList.forEach(c => {
                            contractOptions += `<option value="${c.id}">${c.contractNumber} (${c.vendorName || '-'})</option>`;
                        });
                        $('#contractSelect').html(contractOptions);

                        let ccOptions = '<option value="">-- ค้นหาหรือเลือกแผนก / ฝ่าย --</option>';
                        (res.costCenters || []).forEach(cc => {
                            ccOptions += `<option value="${cc.id}">[${cc.costCenterCode}] ${cc.name}</option>`;
                        });
                        $('#costCenterSelect').html(ccOptions);

                        if ($.fn.select2) {
                            $('#contractSelect').select2({
                                theme: 'bootstrap-5',
                                width: '100%',
                                placeholder: '-- พิมพ์ค้นหาเลขที่สัญญา หรือ ผู้ให้เช่า --',
                                allowClear: true,
                                language: {
                                    noResults: function () {
                                        return 'ไม่พบเลขที่สัญญาที่ค้นหา';
                                    }
                                }
                            });

                            $('#costCenterSelect').select2({
                                theme: 'bootstrap-5',
                                width: '100%',
                                placeholder: '-- พิมพ์ค้นหารหัส หรือ ชื่อแผนก/ฝ่าย --',
                                allowClear: true,
                                language: {
                                    noResults: function () {
                                        return 'ไม่พบแผนก/ฝ่ายที่ค้นหา';
                                    }
                                }
                            });
                        }
                    }
                },
                error: function () {
                    showAlert('danger', 'เกิดข้อผิดพลาดในการโหลดข้อมูลสัญญาและแผนก/ฝ่าย');
                }
            });

            // 2. Contract Selection Change -> Auto Fill Vendor & Rental Type
            $('#contractSelect').on('change', function () {
                const selectedId = parseInt($(this).val());
                const contract = contractsList.find(c => c.id === selectedId);

                if (contract) {
                    $('#vendorNameInput').val(contract.vendorName || '-');
                    $('#rentalTypeNameInput').val(contract.rentalTypeName || '-');
                } else {
                    $('#vendorNameInput').val('');
                    $('#rentalTypeNameInput').val('');
                }
            });

            // Initialize dd/MM/yyyy Datepickers
            if (window.flatpickr) {
                flatpickr('#periodStartDate, #periodEndDate', {
                    dateFormat: 'Y-m-d',
                    altInput: true,
                    altFormat: 'd/m/Y',
                    allowInput: false,
                    onChange: function () {
                        calculatePeriodDuration();
                    }
                });
            }

            // 3. Live Period Duration & Financial Calculation
            $('#periodStartDate, #periodEndDate').on('change input', function () {
                calculatePeriodDuration();
            });

            function calculatePeriodDuration() {
                const startVal = $('#periodStartDate').val();
                const endVal = $('#periodEndDate').val();
                const $box = $('#periodDurationBox');
                const $text = $('#periodDurationText');
                const $daysBadge = $('#periodTotalDaysText');

                if (!startVal || !endVal) {
                    $box.addClass('d-none');
                    return;
                }

                const [sy, sm, sd] = startVal.split('-').map(Number);
                const [ey, em, ed] = endVal.split('-').map(Number);

                const startDate = new Date(Date.UTC(sy, sm - 1, sd));
                const endDate = new Date(Date.UTC(ey, em - 1, ed));

                if (endDate < startDate) {
                    $box.removeClass('d-none')
                        .find('> div')
                        .removeClass('bg-success-subtle text-success')
                        .addClass('bg-danger-subtle text-danger');
                    $text.text('วันสิ้นสุดงวดต้องไม่ก่อนวันเริ่มต้นงวด');
                    $daysBadge.addClass('d-none');
                    return;
                }

                const endExclusive = new Date(Date.UTC(ey, em - 1, ed + 1));
                const totalDays = Math.round((endExclusive - startDate) / (1000 * 60 * 60 * 24));

                let years = endExclusive.getUTCFullYear() - startDate.getUTCFullYear();
                let months = endExclusive.getUTCMonth() - startDate.getUTCMonth();
                let days = endExclusive.getUTCDate() - startDate.getUTCDate();

                if (days < 0) {
                    months -= 1;
                    const prevMonthDays = new Date(Date.UTC(endExclusive.getUTCFullYear(), endExclusive.getUTCMonth(), 0)).getUTCDate();
                    days += prevMonthDays;
                }

                if (months < 0) {
                    years -= 1;
                    months += 12;
                }

                $box.removeClass('d-none')
                    .find('> div')
                    .removeClass('bg-danger-subtle text-danger')
                    .addClass('bg-success-subtle text-success');

                $text.text(`${years} ปี ${months} เดือน ${days} วัน`);
                $daysBadge.removeClass('d-none').text(`รวม ${totalDays.toLocaleString('th-TH')} วัน`);
            }

            $('#amountInput, #vatRateInput').on('input', function () {
                calculateFinancials();
            });

            function calculateFinancials() {
                const amount = parseFloat($('#amountInput').val()) || 0;
                const vatRate = parseFloat($('#vatRateInput').val()) || 0;

                const vatAmount = Math.round((amount * vatRate / 100.0) * 100) / 100;
                const totalAmount = amount + vatAmount;

                $('#vatAmountDisplay').text(vatAmount.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ฿');
                $('#totalAmountDisplay').text(totalAmount.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ฿');

                const $badge = $('#approvalPolicyBadge');
                if (amount <= 0) {
                    $badge.removeClass('bg-success-subtle text-success bg-info-subtle text-info')
                          .addClass('bg-secondary-subtle text-secondary')
                          .text('กรุณาระบุยอดเงินเพื่อประเมินสายอนุมัติ');
                } else if (amount <= 50000) {
                    $badge.removeClass('bg-secondary-subtle text-secondary bg-info-subtle text-info')
                          .addClass('bg-success-subtle text-success')
                          .html('✓ ยอด ≤ 50,000 ฿<br><strong>อนุมัติขั้นเดียวโดย ผู้จัดการ</strong>');
                } else {
                    $badge.removeClass('bg-secondary-subtle text-secondary bg-success-subtle text-success')
                          .addClass('bg-info-subtle text-info-emphasis')
                          .html('✓ ยอด &gt; 50,000 ฿<br><strong>อนุมัติ 2 ขั้น (ผู้จัดการ + ผู้บริหาร)</strong>');
                }
            }

            // 4. PDF File Selection Management
            $('#pdfFileInput').on('change', function () {
                const selected = Array.from(this.files || []);
                for (const file of selected) {
                    if (!file.name.toLowerCase().endsWith('.pdf')) {
                        alert(`อนุญาตเฉพาะไฟล์ .pdf เท่านั้น (${file.name})`);
                        continue;
                    }
                    if (file.size > 15 * 1024 * 1024) {
                        alert(`ไฟล์ ${file.name} มีขนาดเกิน 15 MB`);
                        continue;
                    }
                    pendingFiles.push(file);
                }
                this.value = '';
                renderAttachments();
            });

            function renderAttachments() {
                const $container = $('#attachmentsContainer');
                if (pendingFiles.length === 0) {
                    $container.html('<span class="text-muted small" id="emptyAttachmentNote">ยังไม่ได้เลือกไฟล์เอกสารแนบ</span>');
                    return;
                }

                let html = '';
                pendingFiles.forEach((file, idx) => {
                    const sizeKb = (file.size / 1024).toFixed(1);
                    html += `
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            <span>${file.name} <small class="text-muted">(${sizeKb} KB - รออัปโหลด)</small></span>
                            <button type="button" class="btn-close btn-close-sm" style="font-size: 0.65rem;" onclick="removePendingFile(${idx})"></button>
                        </span>
                    `;
                });
                $container.html(html);
            }

            window.removePendingFile = function (index) {
                pendingFiles.splice(index, 1);
                renderAttachments();
            };

            // 5. Save Draft Action
            $('#btnSaveDraft').on('click', function () {
                saveDraft(false);
            });

            // 6. Submit Action
            $('#btnSubmitRequest').on('click', function () {
                if (!$('#contractSelect').val()) {
                    showAlert('danger', 'กรุณาเลือกเลขที่สัญญาก่อนส่งอนุมัติ');
                    return;
                }
                if (!$('#costCenterSelect').val()) {
                    showAlert('danger', 'กรุณาเลือกแผนก/ฝ่ายก่อนส่งอนุมัติ');
                    return;
                }
                if (!$('#periodStartDate').val() || !$('#periodEndDate').val()) {
                    showAlert('danger', 'กรุณาระบุวันเริ่มต้นและสิ้นสุดงวดค่าเช่า');
                    return;
                }
                const amount = parseFloat($('#amountInput').val()) || 0;
                if (amount <= 0) {
                    showAlert('danger', 'ยอดเงินก่อน VAT ต้องมากกว่า 0');
                    return;
                }
                if (pendingFiles.length === 0) {
                    showAlert('danger', 'กรุณาเลือกไฟล์เอกสารแนบ PDF อย่างน้อย 1 ไฟล์ก่อนส่งอนุมัติ');
                    return;
                }

                if (!confirm('ยืนยันการส่งคำขอค่าเช่านี้เข้าสู่กระบวนการอนุมัติ?')) {
                    return;
                }

                saveDraft(true);
            });

            async function saveDraft(isSubmitAfter) {
                const selectedContractId = $('#contractSelect').val() ? parseInt($('#contractSelect').val()) : null;
                const selectedContract = contractsList.find(c => c.id === selectedContractId);
                const contractNumber = selectedContract ? selectedContract.contractNumber : null;

                const basePayload = {
                    id: 0,
                    contractId: selectedContractId,
                    costCenterId: $('#costCenterSelect').val() ? parseInt($('#costCenterSelect').val()) : null,
                    periodStartDate: $('#periodStartDate').val() || null,
                    periodEndDate: $('#periodEndDate').val() || null,
                    amount: $('#amountInput').val() ? parseFloat($('#amountInput').val()) : null,
                    vatRate: $('#vatRateInput').val() ? parseFloat($('#vatRateInput').val()) : null,
                    notes: $.trim($('#notesInput').val()) || null,
                    attachmentFileNames: []
                };

                $('#btnSaveDraft, #btnSubmitRequest').prop('disabled', true);

                if (isSubmitAfter) {
                    $('#btnSubmitText').text('กำลังประมวลผลคำขอ...');
                } else {
                    $('#btnSaveDraftText').text('กำลังบันทึกร่าง...');
                }

                try {
                    // Step 1: สร้างใบคำขอเพื่อรับ Request ID
                    const createRes = await $.ajax({
                        url: '@Url.Action("SaveDraft", "RentalRequests")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(basePayload)
                    });

                    const newId = createRes.id;
                    let currentVersion = createRes.concurrencyVersion;
                    let uploadedNames = [];

                    // Step 2: หากมีไฟล์ PDF ที่เลือกไว้ ให้อัปโหลดไปเก็บที่ Attachment/<เลขสัญญา หรือ Temp>/<id คำขอ>/YYYYMMDD_HHmmssfff.pdf
                    if (pendingFiles.length > 0) {
                        const formData = new FormData();
                        formData.append('requestId', newId);
                        if (contractNumber) {
                            formData.append('contractNumber', contractNumber);
                        }
                        pendingFiles.forEach(f => formData.append('files', f));

                        const uploadRes = await $.ajax({
                            url: '@Url.Action("UploadAttachments", "RentalRequests")',
                            type: 'POST',
                            data: formData,
                            processData: false,
                            contentType: false
                        });

                        uploadedNames = uploadRes.fileNames || [];

                        // อัปเดตรายชื่อไฟล์จริงลงฐานข้อมูลของใบคำขอ
                        const updateRes = await $.ajax({
                            url: '@Url.Action("SaveDraft", "RentalRequests")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                ...basePayload,
                                id: newId,
                                expectedConcurrencyVersion: currentVersion,
                                attachmentFileNames: uploadedNames
                            })
                        });

                        currentVersion = updateRes.concurrencyVersion;
                    }

                    // Step 3: หากเป็นการกดส่งอนุมัติ ให้ส่ง Submit ต่อทันที
                    if (isSubmitAfter) {
                        await $.ajax({
                            url: `@Url.Action("Submit", "RentalRequests")/${newId}`,
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                expectedConcurrencyVersion: currentVersion,
                                attachmentFileNames: uploadedNames
                            })
                        });

                        showAlert('success', 'อัปโหลดเอกสารและส่งคำขออนุมัติสำเร็จ! กำลังนำไปยังหน้ารายละเอียด...');
                        setTimeout(function () {
                            window.location.href = `@Url.Action("Details", "RentalRequests")/${newId}`;
                        }, 800);
                    } else {
                        showAlert('success', 'บันทึกฉบับร่างและอัปโหลดไฟล์เรียบร้อยแล้ว');
                        setTimeout(function () {
                            window.location.href = `@Url.Action("Details", "RentalRequests")/${newId}`;
                        }, 800);
                    }
                } catch (xhr) {
                    const err = xhr.responseJSON && xhr.responseJSON.detail
                        ? xhr.responseJSON.detail
                        : 'เกิดข้อผิดพลาดในการบันทึกข้อมูลหรืออัปโหลดไฟล์';
                    showAlert('danger', err);
                    resetButtons();
                }
            }

            function resetButtons() {
                $('#btnSaveDraft').prop('disabled', false);
                $('#btnSubmitRequest').prop('disabled', false);
                $('#btnSaveDraftText').text('บันทึกร่าง');
                $('#btnSubmitText').text('ส่งขออนุมัติ');
            }

            function showAlert(type, message) {
                const $box = $('#formAlert');
                $box.removeClass('d-none alert-success alert-danger alert-warning')
                    .addClass('alert-' + type)
                    .html(message);
                $('html, body').animate({ scrollTop: 0 }, 'fast');
            }
        });
    </script>
}
